            color: white;
            text-align: left;
            background-color: transparent;
        }
        #section1 .ihead hr {
            border: 2px solid white;
            width: 45%;
            margin-left: 0;
        }
        #section1 .icontent {
            padding: 0 9%;
            padding-top: 130px;
        }

        #section2 .ihead {
            color: white;
            padding: 100px 0 70px 0;
            text-align: center;
            background-color: rgba(0, 0, 0, 0.7);
            position: static;
        }
        #section2 .ihead hr, #section3 .ihead hr {
            border: 2px solid white;
            width: 110px;
        }

        #section3 {
            color: white;
            background: url(/bg-cosci1.jpeg) center top no-repeat fixed;
            background-size: cover;
        }
        #section3 .ihead {
            background-color: rgba(0, 0, 0, 0.7);
            text-align: center;
            padding-top: 110px;
            padding-bottom: 80px;
        }
        #section3 .ihead .contact-left {
            border-right: 1px solid white;
        }
        #section3 .ihead .contact-hr {
            border-bottom: 1px solid white;
            width: 45%;
            display: none;
        }

        #section4 .ihead {
            color: white;
            padding: 130px 0 70px 0;
            text-align: center;
            background-color: rgba(0, 0, 0, 0.7);
            position: static;
        }

        /* ========== Category & Sets ========== */
        #section2 #categories {
            padding: 25px 0 30px 0;
            text-align: center;
        }
        #section2 #categories a {
            display: inline-block;
            color: #666666;
            font-weight: 500;
            padding: 10px 24px;
            margin: 0 10px;
            margin-bottom: 15px;
            background: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }
        #section2 #categories a.blue-a {
            color: white;
            background-color: #007CB7;
        }
        #section2 #categories a:hover {
            text-decoration: none;
            color: white;
            background-color: #007CB7;
        }

        .a-sets {
            background-color: #dddddd;
            /* width: 270px; */
            width: 80%;
            display: inline-block;
            margin: 15px 2px;
            padding: 4px;
        }
        .a-sets img {
            width: 99%;
            height: 160px;
            /* width: 260px;
            height: 170px; */
            border: 1px solid rgba(255, 255, 255, 0.6);
            background-color: white;
            object-fit: contain;
        }
        .a-sets h4 {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
        }
        .a-sets:hover {
            text-decoration: none;
            color: white;
            background-color: rgb(0, 124, 183, 0.7);
        }
        .a-sets:hover img { opacity: 0.3; }
        .a-sets:hover h4 {
            opacity: 1;
            background-color: darkgray;
            padding: 2px 5px;
            border-radius: 5px;
        }
   #categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  justify-content: center;   /* centers the whole grid if it's narrower than the container */
  max-width: 1000px;         /* optional — caps grid width so it doesn't stretch full-screen */
  margin: 0 auto;            /* centers the grid container itself on the page */
}
.room-card {
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background: white;
  text-align: center;
}

.room-card:hover {
  transform: translateY(-4px);
}

.room-card img {
   width: 220px;
  height: 120px;  /* controls displayed size */
  /*object-fit: cover;  crops to fill without distortion */
  display: block;
}

.room-info {
  padding: 1rem;
}

.room-info h3 {
  margin: 0 0 0.25rem;
  font-size: 1.1rem;
}

.room-info p {
  margin: 0;
  color: #666;
  font-size: 0.9rem;
}

/* Responsive — stack down for smaller screens */
@media (max-width: 900px) {
  .rooms-grid {
    grid-template-columns: repeat(2, 1fr);  /* 2 columns on tablet */
  }
}

@media (max-width: 600px) {
  .rooms-grid {
    grid-template-columns: 1fr;             /* 1 column on mobile */
  }
}
/*=== language switch =====*/
.langu {
    color: #FFFAFA;
  text-decoration: none;
  
}


   /* =================== Resize =================== */
        @media screen and (max-width: 991px) {
            #section1 { padding-top: 160px; padding-bottom: 90px; }
            #section1 .ihead { text-align: center; padding: 5px; }
            #section1 .ihead hr { margin-left: auto; }
            #section1 .icontent { padding: 0 9%; padding-top: 6px; }
            #section2 .ihead { padding: 80px 5px 40px 5px; }
            #section3 .ihead .contact-left { border-right: none; }
            #section3 .ihead .contact-hr { display: block; }
        }
        @media screen and (max-width: 767px) {
            #section1 { padding-top: 100px; padding-bottom: 5px; }
            #section1 .ihead h1 { font-size: 2.5em; }
            #section1 .ihead h3 { font-size: 1.6em; }
            #section1 .icontent { padding: 0 12px; padding-top: 2px; }
            #section2 .ihead { padding-left: 12px; padding-right: 12px; }
        }
 </style>
