<div class="container-fluid">
        <div id="section1" class="row">
            <div class="ihead col-lg-6">
                <h1 style="line-height: 60px;">ระบบจองห้องเรียน</h1>
                <h3>วิทยาลัยนวัตกรรมสื่อสารสังคม</h3>
                <hr>
            </div>
            <div class="icontent col-lg-6">
                <div class="box-login">
                    <h4><%= t('register') %></h4> <br>
                    <% if (error) { %><p style="color:red;"><%= error %></p><% } %>
  <form method="POST" action="/auth/register">
    <!-- Step 1: ID check -->
<div id="step1">
<input type="text" name="buasri" id="buasri" placeholder="<%= t('buasri') %>" required>
  <div class="rank">
    <label><input type="radio" name="role" value="student" checked><%= t('student') %></label>
    <label><input type="radio" name="role" value="staff"><%= t('staff') %></label>
  </div>  
  <p id="step1-error" style="color:red;"></p>
  <button type="button" id="btn-check">ถัดไป</button>
</div>
</form>
<!-- Step 2: full details, hidden until step 1 passes -->
<form method="POST" action="/auth/register" id="step2" style="display:none;">
  <input type="hidden" id="hidden-buasri">
  <input type="hidden" name="role" id="hidden-role">
  <input type="hidden" name="ref_id" id="hidden-ref-id">

  <!-- Student-only fields -->
  <div id="student-fields" style="display:none;">
    <input type="text" id="stu-name" name="name" readonly>
    <input type="text" id="stu-advisor" name="advisor" readonly>
    <input type="text" id="stu-buasri" name="buasri" readonly>
  </div>

  <!-- Staff-only fields -->
  <div id="staff-fields" style="display:none;">
    <input type="text" id="staff-name" name="name" readonly>
    <input type="text" id="staff-advisor" name="advisor" readonly>
    <input type="text" id="staff-buasri" name="buasri" readonly>
  </div>

  <!-- Common fields for both roles -->
  <input type="email" name="email" id="input-email" placeholder="อีเมล" required>
  <input type="password" name="password" placeholder="ตั้งรหัสผ่าน" minlength="4" maxlength="15" required>
  <span style="font-size: 13px; display:block; margin-bottom:10px;">
                        *รหัสผ่านต้องมีอย่างน้อย 4 ตัวอักษร และไม่เกิน 15 ตัวอักษร
                      </span>
  <input type="password" id="inp-pass2" placeholder="ยืนยันรหัสผ่านอีกครั้ง" required>

  

  <button type="submit"><%= t('register') %></button>
</form>
    
    
                            เป็นสมาชิกอยู่แล้ว?&nbsp;
                            <a href="/auth/login" style="font-size:19px; text-decoration:underline;"><%= t('login') %></a> <br>
                            <a href="/forgotPass"><%= t('forgotpass') %></a> &nbsp;&nbsp;
                            <a href="/policy2">นโยบายข้อมูล</a>
                        </p>
  
 
                    
                </div>
