<!DOCTYPE html>
<head>
    <%- include("partials/headtag") -%>
    
    <style>
        body {background-color: #3675AF;}
        .nav-item { margin-left: 20px; }

        #bg-captcha {
            background-image: url(/bg-cosci.png);
            background-position: center;
            background-repeat: no-repeat;
            margin: 0;
        }
        .inBg .ihead {
            padding-top: 170px;
            padding-left: 70px;
            color: white;
            text-align: left;
            background-color: transparent;
        }
        .inBg .ihead hr {
            border: 2px solid white;
            width: 45%;
            margin-left: 0;
        }
        .inBg .icontent {
            padding: 0 9%;
            padding-top: 300px;
        }

        /* ===== Captcha ===== */
        /* prevent interaction with the canvas */
        canvas { pointer-events: none; }
        #imgCaptcha {
            background-color: #333333; /* For browsers that do not support gradients */
            background-image: repeating-linear-gradient(to bottom right, #444444, #666666, #333333 10%);
            border-radius: 3px;
            display: inline-block;
            margin-bottom: 20px;
            width: 45%;
        }


        /* =================== Resize =================== */
        @media screen and (max-width: 991px) {
            .inBg .ihead { text-align: center; padding: 5px; padding-top: 160px; }
            .inBg .ihead hr { margin-left: auto; }
            .inBg .icontent { padding: 0 9%; padding-top: 6px; }
        }
        @media screen and (max-width: 767px) {
            .inBg .ihead { padding-top: 100px; }
            .inBg .ihead h1 { font-size: 2.5em; }
            .inBg .ihead h3 { font-size: 1.6em; }
            .inBg .icontent { padding: 0 12px; padding-top: 2px; }
        }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <a class="navbar-brand" href="">
            <img class="logo" src="/logoCOSCI.png">
        </a>
        <button class="navbar-toggler" data-toggle="collapse" data-target="#navContent" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navContent">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/#section1">เข้าสู่ระบบ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#section2">อุปกรณ์/ครุภัณฑ์</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#section3">ติดต่อ</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="in-body" id="bg-captcha">
        <div class="row inBg" style="margin: 0;">
            <div class="ihead col-lg-6">
                <h1 style="line-height: 60px;">ระบบยืมคืนอุปกรณ์ครุภัณฑ์</h1>
                <h3>วิทยาลัยนวัตกรรมสื่อสารสังคม</h3>
                <hr>
            </div>
            <div class="icontent col-lg-6">
                <div class="box-login">
                    <br>
                    <h5>คุณไม่ใช่โปรแกรมอัตโนมัติ?</h5> <br>
                    <form action="/" method="GET" onsubmit="return checkCaptcha()">
                        <div id="imgCaptcha"> TEST </div>
                        <input id="txtCaptcha" placeholder="ใส่อักษรที่คุณเห็น" >
                        
                        <button type="submit" class="btn-main" style="width:78%;">ยืนยัน</button>
                        <br><br>
                    </form>
                </div>
                <br><br><br>
            </div>
        </div>

    
        <!-- ดึงค่า footer มาแสดงจากไฟล์ footer.ejs -->
        <%- include('partials/footer') -%>
    </div>

</body>

<%- include("partials/foottag") -%>
<script>

    navAction();

    /* ========== CAPTCHA ========== */
    var code;
    function createCaptcha() {
        // clear the contents of captcha div first
        document.getElementById('imgCaptcha').innerHTML = "";
        let charsAll = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ@!#$%^&*";
        let lengthOTP = 6;
        var captcha = [];
        for (i = 0; i < lengthOTP; i++) {
        // สุ่มตัวอักษร โดยไม่ใช้อักษรซ้ำ
        var index = Math.floor(Math.random() * charsAll.length + 1); // get the next character from the array
        if (captcha.indexOf(charsAll[index]) == -1)
            captcha.push(charsAll[index]);
        else i--;
        }
        var canv = document.createElement("canvas");
        canv.width = 150;
        canv.height = 40;
        var ctx = canv.getContext("2d");
        ctx.font = "26px Georgia";
        ctx.strokeText(captcha.join(""), 30, 30);
        // storing captcha so that can validate you can save it somewhere else according to your specific requirements
        code = captcha.join("");
        // adds the canvas to the body element
        document.getElementById("imgCaptcha").appendChild(canv);
    }
    createCaptcha();

    function checkCaptcha() {
        /*
            // stops the default action of an element from happening
            event.preventDefault();
            debugger
        */
        if ( $('#txtCaptcha').val() == code ) {
            // alert("Valid Captcha")
            return true;
        }else{
            alert("ข้อมูลไม่ถูกต้อง โปรดลองอีกครั้ง!");
            createCaptcha();
            return false;
        }
        return false;
    }
    
</script>
</html>