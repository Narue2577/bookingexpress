<script>
navAction();


    /* ===== Sets Portfoilo ===== */
    function filterSelection(c) {
        $('.sinema, .computer').hide();
        if (c == 'all') {
            $('.sinema, .computer').fadeIn("slow");
        }
        else {
            $('.' + c).fadeIn("slow");;
        }
    }

    $('#categories a').click(function() {
        $('#categories .blue-a').removeClass('blue-a');
        $(this).addClass('blue-a');
    });
    
   


