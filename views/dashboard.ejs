            font-weight: 500;
            padding: 10px 24px;
            margin: 0 10px;
            margin-bottom: 15px;
            background: white;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }
        #section2 #categories a.blue-a {
            color: white;
            background-color: #007CB7;
        }
        #section2 #categories a:hover {
            text-decoration: none;
            color: white;
            background-color: #007CB7;
        }

        .a-sets {
            background-color: #dddddd;
            /* width: 270px; */
            width: 80%;
            display: inline-block;
            margin: 15px 2px;
            padding: 4px;
        }
        .a-sets img {
            width: 99%;
            height: 160px;
            /* width: 260px;
            height: 170px; */
            border: 1px solid rgba(255, 255, 255, 0.6);
            background-color: white;
            object-fit: contain;
        }
        .a-sets h4 {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
        }
        .a-sets:hover {
            text-decoration: none;
            color: white;
            background-color: rgb(0, 124, 183, 0.7);
        }
        .a-sets:hover img { opacity: 0.3; }
        .a-sets:hover h4 {
            opacity: 1;
            background-color: darkgray;
            padding: 2px 5px;
            border-radius: 5px;
        }
   #categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  justify-content: center;   /* centers the whole grid if it's narrower than the container */
  max-width: 1000px;         /* optional — caps grid width so it doesn't stretch full-screen */
  margin: 0 auto;            /* centers the grid container itself on the page */
}
.room-card {
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background: white;
  text-align: center;
}

.room-card:hover {
  transform: translateY(-4px);
}

.room-card img {
   width: 220px;
  height: 120px;  /* controls displayed size */
  /*object-fit: cover;  crops to fill without distortion */
  display: block;
}

.room-info {
  padding: 1rem;
}

.room-info h3 {
  margin: 0 0 0.25rem;
  font-size: 1.1rem;
}

.room-info p {
  margin: 0;
  color: #666;
  font-size: 0.9rem;
}
        

        /* =================== Resize =================== */
        @media screen and (max-width: 991px) {
