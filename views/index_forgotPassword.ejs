<!DOCTYPE html>
<head>
    <%- include("partials/headtag") -%>
    
    <style>
        body {background-color: #3675AF;}
        .nav-item { margin-left: 20px; }

        #bg-captcha {
            background-image: url(/bg-cosci.png);
            background-position: center;
            background-repeat: no-repeat;
            margin: 0;
        }
        .inBg .ihead {
            padding-top: 170px;
            padding-left: 70px;
            color: white;
        }
        .inBg .ihead hr {
            border: 2px solid white;
            width: 45%;
            margin-left: 0;
        }
        .inBg .icontent {
            padding: 0 9%;
            padding-top: 300px;
        }


        /* =================== Resize =================== */
        @media screen and (max-width: 991px) {
            .inBg .ihead { text-align: center; padding: 5px; padding-top: 160px; }
            .inBg .ihead hr { margin-left: auto; }
            .inBg .icontent { padding: 0 9%; padding-top: 6px; }
        }
        @media screen and (max-width: 767px) {
            .inBg .ihead { padding-top: 100px; }
            .inBg .ihead h1 { font-size: 2.5em; }
            .inBg .ihead h3 { font-size: 1.6em; }
            .inBg .icontent { padding: 0 12px; padding-top: 2px; }
        }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <a class="navbar-brand" href="">
            <img class="logo" src="/logoCOSCI.png">
        </a>
        <button class="navbar-toggler" data-toggle="collapse" data-target="#navContent" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navContent">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/#section1">เข้าสู่ระบบ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#section2">อุปกรณ์/ครุภัณฑ์</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/#section3">ติดต่อ</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="in-body" id="bg-captcha">
        <div class="row inBg" style="margin: 0;">
            <div class="ihead col-lg-6">
                <h1 style="line-height: 60px;">ระบบยืมคืนอุปกรณ์ครุภัณฑ์</h1>
                <h3>วิทยาลัยนวัตกรรมสื่อสารสังคม</h3>
                <hr>
            </div>
            <div class="icontent col-lg-6">
                <div class="box-login">
                    <br>
                    <h5>ลืมรหัสผ่าน</h5> <br>
                  
                    <form id="reqPass" action="/requestPass" method="POST">
                        <input name="fopusername" placeholder="บัวศรีไอดี (Buasri ID)" required>
                        
                        <button type="submit" class="btn-main" style="width:78%;" onclick="canSubmit()">ยืนยัน</button>
                        <br><br>
                    </form>
                    <p id="sentPass">โปรดตรวจสอบรหัสใหม่ที่อีเมลของคุณ <br></p>

                    <a href="/" class="btn-gray" style="width:78%;">เข้าสู่ระบบ</a>
                    <br><br>
                </div>
                <br><br><br>
            </div>
        </div>

    
        <!-- ดึงค่า footer มาแสดงจากไฟล์ footer.ejs -->
        <%- include('partials/footer') -%>
    </div>

</body>

<%- include("partials/foottag") -%>

<!-- ======= Sweetalert2 ======= -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/sweetalert2/6.1.1/sweetalert2.min.css">
<script type="text/javascript" src="https://cdn.jsdelivr.net/sweetalert2/6.1.1/sweetalert2.min.js"></script>
<script>

    navAction();

    /* ===== Hide/Show Content ===== */
    var reqPasss = document.getElementById("reqPass");
    var sentPass = document.getElementById("sentPass");
    
    
    function canSubmit() {
        swal({
            title:              "กำลังประมวลผล โปรดรอสักครู่...",
            text:               "",
            showConfirmButton:  false,
            type:               "success"
        })
    }
    
</script>
</html>