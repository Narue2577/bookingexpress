                <br><br>
    
                <h5>เปลี่ยนรหัสผ่าน</h5> <hr>
                <div class="box-ww98">
                    <!-- Add this block right before your password form -->
                    <% if (error === 'oldpass') { %>
                        <p style="color:red;">รหัสผ่านเดิมไม่ถูกต้อง!</p>
                    <% } %>
                    <% if (error === 'server') { %>
                        <p style="color:red;">เกิดข้อผิดพลาด กรุณาลองใหม่</p>
                    <% } %>
                    <% if (success === 'passchanged') { %>
                        <p style="color:green;">เปลี่ยนรหัสผ่านสำเร็จ</p>
                    <% } %>

                    <form action="/profile/edit-pass" method="POST" id="pass-form">
                        <div class="row" style="padding-top: 12px;">
                            <div class="col-lg-3 spaceDiv"><b>รหัสผ่านเดิม</b></div>
                            <div class="col-lg-9 spaceDiv">
                                <input id="oldpass1" name="oldpass" type="password" class="basic-input" style="width:99%;" required>
                                
                                <br>
                                <span id="oldnomatch0" style="color:red; display:none;">
                                    รหัสผ่านเดิมไม่ถูกต้อง!
                                </span>
                            </div>
                            <div class="col-lg-3 spaceDiv"><b>รหัสผ่านใหม่</b></div>
                            <div class="col-lg-9 spaceDiv">
                                <input name="newpass" id="newpass" type="password" class="basic-input" style="width:99%;" minlength="4" maxlength="15" required>
                                <span style="display: block; color: #333; font-size: 12px;">รหัสผ่านต้องมีความยาว 4 ถึง 15 ตัวอักษร</span>
                            </div>
                            <div class="col-lg-3 spaceDiv"><b>ยืนยันรหัสผ่านใหม่</b></div>
                            <div class="col-lg-9 spaceDiv">
                                <input id="newpass2" type="password" class="basic-input" style="width:99%;" minlength="4" maxlength="15" required>
                                <br>
                                <span id="passnomatch" style="color:red; display:none;">
                                    รหัสผ่านใหม่ไม่ตรงกัน!!
                                </span>
                            </div>
                            <div class="col-lg-12" style="text-align: right;">
                                <br>
                                <a href="/profile" class="btn-cancel">ยกเลิก</a>
